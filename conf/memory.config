// Default genomeSize — overridden by the cluster-side generated config.
// With genomeSize = 0 all processes floor to the next power-of-2 above baseGb * 1.25.
params {
  genomeSize = 0
}

// Each withName block below computes memory inline as:
//   round_up_to_power_of_2((genomeGb * multiplier + baseGb) * 1.25) * attempt
// Nextflow's config parser no longer allows a shared top-level helper closure/function
// (variable/function declarations can't be mixed with config statements), so the formula
// is duplicated per process rather than factored into one `memForProcess` helper.
//
// clusterOptions explicitly re-specifies -M/-R with an explicit "MB" unit suffix on LSF.
// Nextflow's LSF executor (as of 24.10.3) is supposed to auto-detect the cluster's real
// LSF_UNIT_FOR_LIMITS from lsf.conf and use it consistently for both -M and rusage[mem=],
// but that detection has been observed to fail intermittently in production (submitted job
// then requests memory 1024x too large — KB misread as MB — and gets rejected by the queue
// with "MEMLIMIT: Cannot exceed queue's hard limit(s)"). clusterOptions is always appended
// after Nextflow's own built-in -M/-R directives, and LSF takes the last -M and the last
// occurrence of each -R section (select[]/rusage[]) — so an explicit unit suffix here wins
// regardless of whether auto-detection worked, sidestepping the ambiguity entirely. No-op
// on non-LSF executors.
process {
  // To manually override memory for debugging, replace the closure with a fixed value, e.g.:
  //   withName: 'bwaMem' { memory = '32 GB' }
  withName: 'bwaMem' {
    memory = {
      def genomeGb = params.genomeSize / 1_000_000_000.0
      def rawGb    = (genomeGb * 3.3) + 2
      def safeGb   = (rawGb * 1.25) as double
      def memGb    = Math.pow(2, Math.ceil(Math.log(Math.max(safeGb, 1.0d)) / Math.log(2))) as int
      return "${memGb * task.attempt} GB"
    }
    clusterOptions = { "-M ${task.memory.toMega()}MB -R \"select[mem>=${task.memory.toMega()}MB] rusage[mem=${task.memory.toMega()}MB]\"" }
    maxRetries    = 1
    errorStrategy = { task.exitStatus in 130..140 ? 'retry' : 'finish' }
  }
  withName: 'runFreebayes' {
    memory = {
      def genomeGb = params.genomeSize / 1_000_000_000.0
      def rawGb    = (genomeGb * 2.0) + 2
      def safeGb   = (rawGb * 1.25) as double
      def memGb    = Math.pow(2, Math.ceil(Math.log(Math.max(safeGb, 1.0d)) / Math.log(2))) as int
      return "${memGb * task.attempt} GB"
    }
    clusterOptions = { "-M ${task.memory.toMega()}MB -R \"select[mem>=${task.memory.toMega()}MB] rusage[mem=${task.memory.toMega()}MB]\"" }
    maxRetries    = 1
    errorStrategy = { task.exitStatus in 130..140 ? 'retry' : 'finish' }
  }
  withName: 'picard' {
    memory = {
      def genomeGb = params.genomeSize / 1_000_000_000.0
      def rawGb    = (genomeGb * 1.0) + 2
      def safeGb   = (rawGb * 1.25) as double
      def memGb    = Math.pow(2, Math.ceil(Math.log(Math.max(safeGb, 1.0d)) / Math.log(2))) as int
      return "${memGb * task.attempt} GB"
    }
    clusterOptions = { "-M ${task.memory.toMega()}MB -R \"select[mem>=${task.memory.toMega()}MB] rusage[mem=${task.memory.toMega()}MB]\"" }
  }
  withName: 'gatk' {
    memory = {
      def genomeGb = params.genomeSize / 1_000_000_000.0
      def rawGb    = (genomeGb * 2.0) + 2
      def safeGb   = (rawGb * 1.25) as double
      def memGb    = Math.pow(2, Math.ceil(Math.log(Math.max(safeGb, 1.0d)) / Math.log(2))) as int
      return "${memGb * task.attempt} GB"
    }
    clusterOptions = { "-M ${task.memory.toMega()}MB -R \"select[mem>=${task.memory.toMega()}MB] rusage[mem=${task.memory.toMega()}MB]\"" }
  }
  withName: 'htseqCount' {
    memory = {
      def genomeGb = params.genomeSize / 1_000_000_000.0
      def rawGb    = (genomeGb * 0.3) + 4
      def safeGb   = (rawGb * 1.25) as double
      def memGb    = Math.pow(2, Math.ceil(Math.log(Math.max(safeGb, 1.0d)) / Math.log(2))) as int
      return "${memGb * task.attempt} GB"
    }
    clusterOptions = { "-M ${task.memory.toMega()}MB -R \"select[mem>=${task.memory.toMega()}MB] rusage[mem=${task.memory.toMega()}MB]\"" }
    maxRetries    = 1
    errorStrategy = { task.exitStatus in 130..140 ? 'retry' : 'finish' }
  }
}
