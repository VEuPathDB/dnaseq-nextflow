// Default genomeSize — overridden by the cluster-side generated config.
// With genomeSize = 0 all processes floor to the next power-of-2 above baseGb * 1.25.
params {
  genomeSize = 0
}

// Each withName block below computes memory (in GB) inline as:
//   round_up_to_power_of_2((genomeGb * multiplier + baseGb) * 1.25) * attempt
// Nextflow's config parser no longer allows a shared top-level helper closure/function
// (variable/function declarations can't be mixed with config statements), so the formula
// is duplicated per process rather than factored into one `memForProcess` helper.
//
// This is deliberately NOT the built-in `memory` directive. Nextflow's LSF executor emits
// its own -M/-R directives whenever `memory` is set, and on this cluster that computation is
// unreliable (it's supposed to auto-detect the cluster's real LSF_UNIT_FOR_LIMITS from
// lsf.conf, but that detection has been observed to fail intermittently in production,
// computing -M in KB and getting it misread as MB by the scheduler — 1024x too large,
// rejected with "MEMLIMIT: Cannot exceed queue's hard limit(s)"). Appending a corrected
// clusterOptions -M/-R after Nextflow's own does NOT fix this: LSF takes the FIRST -M/-R
// directive when bsub reads them from a script file, not the last, so Nextflow's broken one
// always wins over a corrected one appended afterward. The only reliable fix is to never let
// Nextflow emit its own -M/-R at all: `memory` is left unset (so LsfExecutor's `if
// (task.config.getMemory())` check is false), and `ext.memGb` carries the value instead —
// used directly for JVM heap sizing in the picard/gatk scripts, and by clusterOptions below
// for the one-and-only -M/-R actually sent to bsub.
process {
  // Process-wide default so every job reserves memory; unreserved jobs fail allocating on
  // overcommitted nodes. Steps with their own ext.memGb use it; others get 2 GB (4 GB on retry).
  // ext.memGb is not set here: a process-level ext.memGb breaks the withName blocks below.
  // Exit codes 1, 2, 134, 255 are allocation failures; 130..145 are LSF kills.
  clusterOptions = {
    def gb = task.ext.memGb ?: 2 * task.attempt
    "-M ${gb * 1024}MB -R \"select[mem>=${gb * 1024}MB] rusage[mem=${gb * 1024}MB]\""
  }
  maxRetries     = 1
  errorStrategy  = { task.exitStatus in [1, 2, 134, 255] || task.exitStatus in 130..145 ? 'retry' : 'finish' }

  // To manually override memory for debugging, replace the closure with a fixed value, e.g.:
  //   withName: 'bwaMem' { ext.memGb = 32 }
  withName: 'sortForCounting' {
    ext.memGb = { 4 * task.attempt }
  }
  withName: 'bedGraphToBigWig' {
    ext.memGb = { 4 * task.attempt }
  }
  withName: 'bwaMem' {
    ext.memGb = {
      def genomeGb = params.genomeSize / 1_000_000_000.0
      def rawGb    = (genomeGb * 3.3) + 2
      def safeGb   = (rawGb * 1.25) as double
      (Math.pow(2, Math.ceil(Math.log(Math.max(safeGb, 1.0d)) / Math.log(2))) as int) * task.attempt
    }
  }
  withName: 'runFreebayes' {
    ext.memGb = {
      def genomeGb = params.genomeSize / 1_000_000_000.0
      def rawGb    = (genomeGb * 2.0) + 2
      def safeGb   = (rawGb * 1.25) as double
      (Math.pow(2, Math.ceil(Math.log(Math.max(safeGb, 1.0d)) / Math.log(2))) as int) * task.attempt
    }
  }
  withName: 'picard' {
    ext.memGb = {
      def genomeGb = params.genomeSize / 1_000_000_000.0
      def rawGb    = (genomeGb * 1.0) + 2
      def safeGb   = (rawGb * 1.25) as double
      (Math.pow(2, Math.ceil(Math.log(Math.max(safeGb, 1.0d)) / Math.log(2))) as int) * task.attempt
    }
  }
  withName: 'gatk' {
    ext.memGb = {
      def genomeGb = params.genomeSize / 1_000_000_000.0
      def rawGb    = (genomeGb * 2.0) + 2
      def safeGb   = (rawGb * 1.25) as double
      (Math.pow(2, Math.ceil(Math.log(Math.max(safeGb, 1.0d)) / Math.log(2))) as int) * task.attempt
    }
  }
  withName: 'htseqCount' {
    ext.memGb = {
      def genomeGb = params.genomeSize / 1_000_000_000.0
      def rawGb    = (genomeGb * 0.3) + 4
      def safeGb   = (rawGb * 1.25) as double
      (Math.pow(2, Math.ceil(Math.log(Math.max(safeGb, 1.0d)) / Math.log(2))) as int) * task.attempt
    }
  }
}
