// Default genomeSize — overridden by the cluster-side generated config.
// With genomeSize = 0 all processes floor to 4 GB, which is fine for local dev.
params {
  genomeSize = 0
}

// Compute memory as a function of genome size and retry attempt.
// Formula: round_up_to_power_of_2((genomeGb * multiplier + baseGb) * 1.25) * attempt
// With 30x coverage cap, BAM size scales with genome size, making this formula
// valid for all four processes below.
def memForProcess = { genomeSizeBytes, multiplier, baseGb, attempt ->
    def genomeGb = genomeSizeBytes / 1_000_000_000
    def rawGb    = (genomeGb * multiplier) + baseGb
    def safeGb   = rawGb * 1.25
    def memGb    = 1
    while (memGb < safeGb) memGb *= 2
    return "${memGb * attempt} GB"
}

process {
  // To manually override memory for debugging, replace the closure with a fixed value, e.g.:
  //   withName: 'bwaMem' { memory = '32 GB' }
  withName: 'bwaMem' {
    memory        = { memForProcess(params.genomeSize, 3.3, 2, task.attempt) }
    maxRetries    = 1
    errorStrategy = { task.exitStatus in 130..140 ? 'retry' : 'finish' }
  }
  withName: 'runFreebayes' {
    memory        = { memForProcess(params.genomeSize, 2.0, 2, task.attempt) }
    maxRetries    = 1
    errorStrategy = { task.exitStatus in 130..140 ? 'retry' : 'finish' }
  }
  withName: 'picard' {
    memory = { memForProcess(params.genomeSize, 1.0, 2, task.attempt) }
  }
  withName: 'gatk' {
    memory = { memForProcess(params.genomeSize, 1.0, 2, task.attempt) }
  }
}

profiles {

  //--------------------------------------------------------------------------------------------
  // processSingleExperiment
  //--------------------------------------------------------------------------------------------

  processSingleExperiment {

    params {
      // Input samplesheet in nf-core CSV format
      // Required columns: sample, fastq_1, fastq_2 (fastq_2 can be empty for single-end)
      samplesheet = "$baseDir/data/samplesheet_chr1.csv"
      bwaThreads = 4
      minCoverage = 1
      genomeFastaFile = "$baseDir/data/genome_haploid/genome.fasta"
      gtfFile = "$baseDir/data/haploid_paired/Shared/pfal3D7.gtf"
      footprintFile = "$baseDir/data/haploid_paired/Shared/geneFootprintsFile"
      winLen = 1000
      ploidy=1
      genomeRepeatsBedFile = null
      outputDir = "$launchDir/output"
      geneSourceIdOrthologFile = "$baseDir/data/haploid_paired/Shared/geneSourceIdOrthologFile.tsv"
      chrsForCalcFile = "$baseDir/data/haploid_paired/Shared/chrsForCalcsFile.tsv"
    }

    docker {
      enabled = true
      runOptions = '--user root'
    }

  }

  //--------------------------------------------------------------------------------------------
  // loadSingleExperiment
  //--------------------------------------------------------------------------------------------

  loadSingleExperiment {

    params {

      indelDir = "$launchDir/output/"
      extDbRlsSpec = '"lmajFriedlin_NGS_SNPsAndVariations|do_not_care"'
      genomeExtDbRlsSpec = '"RDEMKO|do_not_care"'      

    }

  }

  //--------------------------------------------------------------------------------------------
  // mergeExperiments
  //--------------------------------------------------------------------------------------------

  mergeExperiments {

    params {
      vcfFiles                     = "$launchDir/data/merge_setup/**/results/*.vcf.gz" // per-sample {sampleName}.vcf.gz; freebayes.snps/indels.vcf.gz must not be published to outputDir
      coverageFiles                = "$launchDir/data/merge_setup/**/results/*.coverage.bed.gz"
      indelsFiles                  = "$launchDir/data/merge_setup/**/results/indels.tsv"
      relativeConsensusFilePattern = "$launchDir/data/merge_setup/**/results/*_consensus.fa.gz"
      cacheFile                 = "$launchDir/data/merge_setup/cache.tsv"
      outputDir       = "$launchDir/output/"
      genomeFastaFile = "$launchDir/data/genome_haploid/genome.fasta"
      gtfFile         = "$launchDir/data/haploid_paired/Shared/pfal3D7.gtf"
      undoneStrains   = "$launchDir/data/merge_setup/undoneStrains.txt"
      reference_strain = 'pfal3D7'
    }

   docker {
      enabled = true
    }

  }

  //--------------------------------------------------------------------------------------------
  // tests
  //--------------------------------------------------------------------------------------------

  tests {

    params {
      testDir = '$baseDir/testing/t/'
      outputDir = '$baseDir/output/'
    }

    docker {
      enabled = true
    }

  }
  
}
